# Web tier — docs/architecture/17-deployment-architecture.md §3
# Only NEXT_PUBLIC_* values reach the browser. A mis-prefixed secret here would be
# published in the client bundle, so this naming is a security boundary.
NODE_ENV=development
PORT=3001
API_INTERNAL_URL=http://localhost:3000
SESSION_COOKIE_SECRET=change-me-at-least-32-characters-long
NEXT_PUBLIC_ISSUER_URL=http://localhost:3000
NEXT_PUBLIC_ASSET_HOST=http://localhost:3001
