# apps/api — copy to .env (gitignored). The backend is a standalone Node.js service.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# OIDC issuer identity (iss claim + discovery base).
ISSUER_URL=http://localhost:3000

# Runtime DB connection: the non-bypass app_role so RLS applies (AR-009).
# This is the APP_DATABASE_URL from packages/db/.env, NOT the owner URL.
DATABASE_URL=postgresql://app_role:password@host.region.aws.neon.tech/db?sslmode=require
DATABASE_POOL_MAX=10

# Token lifetimes (ADR-004).
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# Encrypts JWT signing private keys at rest (AES-256-GCM); 32+ chars. A KMS key
# replaces this in production (15 §5). Generate: openssl rand -hex 32
JWK_ENCRYPTION_KEY=generate-a-32-byte-hex-secret

# Account lockout (05 §3). Lockout is the per-account defense; indistinguishable
# from a wrong password.
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15
