# @cp/db — copy to .env (gitignored) and fill in. Never commit real values.

# Pooled endpoint (PgBouncer, transaction mode) — application runtime.
DATABASE_URL=postgresql://user:password@host-pooler.region.aws.neon.tech/db?sslmode=require

# Direct endpoint (no -pooler) — migrations (DDL, advisory locks, CREATE ROLE).
DATABASE_MIGRATION_URL=postgresql://user:password@host.region.aws.neon.tech/db?sslmode=require

# App-role endpoint — runtime + RLS tests. A role WITHOUT bypassrls so RLS applies
# (the Neon owner has bypassrls). Set up via: pnpm tsx src/scripts/setup-app-role.ts
APP_DATABASE_URL=postgresql://app_role:password@host.region.aws.neon.tech/db?sslmode=require

# Used once by setup-app-role.ts to set app_role's login password.
APP_ROLE_PASSWORD=generate-a-hex-secret
